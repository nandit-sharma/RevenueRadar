# RevenueRadar Backend Environment Variables

# GCP Configuration (optional - needed for BigQuery)
GCP_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET=revenue_radar
BIGQUERY_TABLE=sales_data

# AI Configuration (optional - enhances chatbot)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Set to false to use BigQuery instead of mock data
USE_MOCK_DATA=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
